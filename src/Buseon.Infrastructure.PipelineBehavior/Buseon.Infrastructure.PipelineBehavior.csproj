        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <PackageId>Buseon.Infrastructure.PipelineBehavior</PackageId>
        <Version>0.1.0</Version>
        <Authors>Rodrigo Lessa</Authors>
        <Company>Buseon</Company>
        <Description>Intercept execution to inject context and validate inputs</Description>

        <PackageTags>Pipeline behavior Context Input Validation</PackageTags>
        <RepositoryUrl>https://github.com/rodrigolessa/buseon-infrastructure-cqrs</RepositoryUrl>

        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

</Project>
