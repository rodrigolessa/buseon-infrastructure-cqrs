<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <PackageId>Buseon.Infrastructure.Validation</PackageId>
        <Version>0.1.1</Version>
        <Authors>Rodrigo Lessa</Authors>
        <Company>Buseon</Company>
        <Description>Intercept execution to inject context and validate inputs - Pipeline is a architectural extension</Description>

        <PackageTags>Pipeline behavior Context Input Validation</PackageTags>
        <RepositoryUrl>https://github.com/rodrigolessa/buseon-infrastructure-cqrs</RepositoryUrl>

        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

        <RootNamespace>Buseon.Infrastructure.Validation</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Buseon.Infrastructure\Buseon.Infrastructure.csproj" />
    </ItemGroup>

</Project>
